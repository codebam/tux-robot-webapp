{
	"name": "webapp",
	"private": true,
	"version": "0.0.31",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npx wrangler types --check && vite build",
		"deploy": "npx wrangler pages deploy .svelte-kit/cloudflare --project-name telegram-webapp",
		"preview": "npx wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npx wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "npx wrangler types",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test:node": "vitest run --project server",
		"test": "npm run test:node"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"playwright": "1.61.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.1.5",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.94.0"
	},
	"dependencies": {
		"@cloudflare/ai-utils": "^1.0.1",
		"@codebam/shared": "*",
		"marked": "^18.0.7"
	}
}
