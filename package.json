{
	"name": "webapp",
	"private": true,
	"version": "0.0.31",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npx wrangler types --check && vite build",
		"deploy": "npx wrangler pages deploy .svelte-kit/cloudflare --project-name telegram-webapp",
		"preview": "npx wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npx wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "npx wrangler types",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test:node": "vitest run --project server",
		"test": "npm run test:node"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.6",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.5.0",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "1.61.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.2",
		"@opentelemetry/api": "^1.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.130.0"
	},
	"dependencies": {
		"@cloudflare/ai-utils": "^1.0.1",
		"@codebam/shared": "*",
		"marked": "^18.0.12"
	}
}
